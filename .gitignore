# Secrets
.env
*.pem

# Data. The raw extract is downloaded, not committed; processed artefacts
# and scored outputs are rebuilt by `make all`.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

